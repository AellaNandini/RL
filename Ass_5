        "import gymnasium as gym\n",
        "\n",
        "\n",
        "def random_agent(env_name):\n",
        "\n",
        "    # Create environment\n",
        "    env = gym.make(env_name)\n",
        "\n",
        "    # Reset environment\n",
        "    state, info = env.reset()\n",
        "\n",
        "    total_reward = 0\n",
        "    steps = 0\n",
        "\n",
        "    print(\"\\n======================================\")\n",
        "    print(\"Environment:\", env_name)\n",
        "    print(\"======================================\")\n",
        "\n",
        "    print(\"Initial State:\", state)\n",
        "    print(\"Action Space:\", env.action_space)\n",
        "\n",
        "    while True:\n",
        "\n",
        "        # Select random action\n",
        "        action = env.action_space.sample()\n",
        "\n",
        "        # Execute action\n",
        "        next_state, reward, terminated, truncated, info = env.step(action)\n",
        "\n",
        "        # Display interaction\n",
        "        print(\"Step:\", steps + 1,\n",
        "              \"| Action:\", action,\n",
        "              \"| Reward:\", reward,\n",
        "              \"| Next State:\", next_state)\n",
        "\n",
        "        # Update values\n",
        "        state = next_state\n",
        "        total_reward += reward\n",
        "        steps += 1\n",
        "\n",
        "        # Stop when episode ends\n",
        "        if terminated or truncated:\n",
        "            break\n",
        "\n",
        "    # Calculate average reward\n",
        "    average_reward = total_reward / steps\n",
        "\n",
        "    print(\"\\nTotal Reward:\", total_reward)\n",
        "    print(\"Number of Steps:\", steps)\n",
        "    print(\"Average Reward:\", round(average_reward, 2))\n",
        "\n",
        "    env.close()\n",
        "\n",
        "\n",
        "# Run all three environments\n",
        "random_agent(\"CartPole-v1\")\n",
        "random_agent(\"MountainCar-v0\")\n",
        "random_agent(\"FrozenLake-v1\")"
      ],
